# Nacos 3 启动所需的节点身份。请复制为 .env 并生成独立值，不要提交真实凭据。
NACOS_AUTH_TOKEN=<base64-encoded-random-value-at-least-32-bytes>
NACOS_AUTH_IDENTITY_KEY=<random-identity-key>
NACOS_AUTH_IDENTITY_VALUE=<random-identity-value>

# 如 Sentinel JAR 不在默认目录，可覆盖此路径。
SENTINEL_JAR_PATH=D:/middleware/runtime/sentinel-1.8.9/sentinel-dashboard-1.8.9.jar

# 所有应用服务共享；每项使用独立的至少 32 字符随机值。
JWT_SECRET=<independent-random-secret-at-least-32-characters>
INTERNAL_SERVICE_TOKEN=<independent-random-secret-at-least-32-characters>
# 首次启动创建管理员；已有账号不会被重复启动重置密码。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=<independent-random-password-at-least-12-characters>
# 默认关闭测试支付，接真实渠道时保持关闭。
PAYMENT_MOCK_ENABLED=false
