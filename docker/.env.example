# Nacos 3 启动所需的节点身份。请复制为 .env 并生成独立值，不要提交真实凭据。
NACOS_AUTH_TOKEN=<base64-encoded-random-value-at-least-32-bytes>
NACOS_AUTH_IDENTITY_KEY=<random-identity-key>
NACOS_AUTH_IDENTITY_VALUE=<random-identity-value>

# 如 Sentinel JAR 不在默认目录，可覆盖此路径。
SENTINEL_JAR_PATH=D:/middleware/runtime/sentinel-1.8.9/sentinel-dashboard-1.8.9.jar
